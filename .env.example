# LLM (existing demo nodes)
MODEL_API_KEY=your-model-api-key
MODEL_BASE_URL=https://api.deepseek.com/anthropic
MODEL_NAME=deepseek-flash

# Dify Chatflow app (V1 knowledge QA)
DIFY_API_KEY=app-your-dify-app-api-key
DIFY_API_URL=https://api.dify.ai/v1

# Dify client tuning
# Total attempts = DIFY_MAX_RETRIES + 1.
DIFY_TIMEOUT_SECONDS=30
DIFY_MAX_RETRIES=1
DIFY_RETRY_BACKOFF_SECONDS=1
# Retrying a timed-out chat message may create a duplicate message in Dify.
DIFY_RETRY_ON_TIMEOUT=false
